# AI Meeting & Follow-Up Agent — Environment Configuration
# -----------------------------------------------------------

# Google Gemini API Key for live LLM extraction.
# If omitted, the agent uses built-in NLP heuristic extraction.
GEMINI_API_KEY=

# Optional: Real email dispatch credentials (SendGrid / SMTP).
# If omitted, reminders fall back to simulated mode.
EMAIL_API_KEY=
EMAIL_FROM=

# Demo Mode: Compressed reminder loop intervals for hackathon demos.
DEMO_MODE=true
